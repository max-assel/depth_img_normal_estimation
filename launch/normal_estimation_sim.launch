<launch>

    <param name="camera_depth_topic"    value="/camera/depth/image_raw"/>
    <param name="config_path"           value="$(find depth_img_normal_estimation)/cfg/sim.yaml"/>
    <param name="hardware"              value="false"/> 

    <!-- Normal Estimation -->
    <node pkg="depth_img_normal_estimation" type="normal_estimation_node" name="normal_estimation_node" output="screen">

    </node>

</launch>